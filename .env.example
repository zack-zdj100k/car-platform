# ==========================================================================
# CAR PLATFORM — ENVIRONMENT TEMPLATE (spec §67)
# Copy to .env and fill in real values. NEVER commit .env.
# ==========================================================================

# --- Database (PostgreSQL + Prisma) --------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/car_platform_dev?schema=public"
# Separate database used by integration/e2e tests
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/car_platform_test?schema=public"

# --- Backend (NestJS) ----------------------------------------------------
# NODE_ENV is deliberately NOT set here.
#
# It is supplied by whatever runs the process: `next dev` and `next build` set
# it themselves, and a deployment sets it for the API. Exporting NODE_ENV from
# this file (for example `set -a; . ./.env`) and then running a production build
# makes Next resolve a development React runtime, and the build fails while
# prerendering with "Cannot read properties of null (reading 'useContext')".
# The backend defaults to development when it is unset.
BACKEND_PORT=4000
API_PREFIX="api"
# Comma-separated list of allowed origins (CORS).
# 3000 is the dev server; 3100 is the production build the end-to-end suite
# serves. An origin that is not listed here is refused — which is the point.
CORS_ORIGINS="http://localhost:3000,http://localhost:3100"

# --- Authentication ------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
COOKIE_DOMAIN="localhost"
COOKIE_SECURE="false"

# --- Google OAuth (spec §3, §36) ----------------------------------------
# Leave empty to disable the Google sign-in provider at runtime.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# --- Email / notifications (spec §26, §69) ------------------------------
# Provider is pluggable: "smtp" | "console" (console logs instead of sending)
MAIL_PROVIDER="console"
MAIL_HOST=""
MAIL_PORT=587
MAIL_SECURE="false"
MAIL_USER=""
MAIL_PASSWORD=""
MAIL_FROM="Car Platform <no-reply@example.com>"
# Administrator address that receives new-order notifications
ADMIN_NOTIFICATION_EMAIL="admin@example.com"

# --- Frontend (Next.js) --------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Order workflow ------------------------------------------------------
# true  = customer must be signed in to submit an order (system graph)
# false = guests may submit orders (master prompt §24/§54, user_id nullable)
REQUIRE_AUTH_FOR_ORDERS="true"

# --- Uploads -------------------------------------------------------------
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=8

# --- Rate limiting (spec §57, §67) --------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# --- Seed credentials (development only, spec §73) ----------------------
SEED_ADMIN_EMAIL="admin@carplatform.dev"
SEED_ADMIN_PASSWORD="ChangeMe!Admin123"
SEED_CUSTOMER_EMAIL="customer@carplatform.dev"
SEED_CUSTOMER_PASSWORD="ChangeMe!Customer123"
