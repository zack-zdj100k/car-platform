{
  "name": "car-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Premium automotive platform \u2014 Next.js + NestJS + Prisma + PostgreSQL",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev-preflight.mjs && concurrently --kill-others-on-fail --names FRONTEND,BACKEND,READY --prefix-colors cyan.bold,magenta.bold,green.bold --prefix \"[{name}]\" \"npm:dev:frontend\" \"npm:dev:backend\" \"npm:dev:ready\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run start:dev --workspace backend",
    "dev:ready": "node scripts/dev-ready.mjs",
    "doctor": "node scripts/dev-preflight.mjs",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "start": "concurrently --kill-others --names FRONTEND,BACKEND --prefix-colors cyan.bold,magenta.bold --prefix \"[{name}]\" \"npm:start:frontend\" \"npm:start:backend\"",
    "start:frontend": "npm run start --workspace frontend",
    "start:backend": "npm run start:prod --workspace backend",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "analytics:reset": "node scripts/reset-analytics.mjs",
    "make:admin": "node scripts/make-admin.mjs",
    "typecheck": "npm run typecheck --workspace backend && npm run typecheck --workspace frontend",
    "lint": "npm run lint --workspace backend && npm run lint --workspace frontend",
    "test": "npm run test --workspace backend && npm run test --workspace frontend",
    "test:e2e": "npm run test:e2e --workspace frontend"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "npm-run-all": "^4.1.5",
    "prisma": "6.19.3",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "argon2": "^0.44.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
