// ============================================================================
// CAR PLATFORM — PRISMA SCHEMA
// PostgreSQL. Typed relational columns (spec §50: no blanket JSON storage).
// Spec references in comments map to MASTER CLAUDE CODE SPECIFICATION sections.
// ============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

/// Spec §3, §38 — role-based authorization (verified backend-side)
enum Role {
  CUSTOMER
  ADMIN
}

/// Spec §48 — admin may manage account status
enum UserStatus {
  ACTIVE
  SUSPENDED
}

/// Spec §46, §55 — publish/unpublish + soft archive so order history survives
enum CarStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Spec §25 — order status system
enum OrderStatus {
  PENDING
  CONTACTED
  CONFIRMED
  CANCELLED
  COMPLETED
}

/// Spec §15 — body type / segment
enum BodyType {
  SUV
  CROSSOVER
  SEDAN
  HATCHBACK
  COUPE
  CONVERTIBLE
  WAGON
  MPV
  VAN
  PICKUP
}

/// Spec §16 — fuel type
enum FuelType {
  PETROL
  DIESEL
  HYBRID
  PLUG_IN_HYBRID
  ELECTRIC
  LPG
  CNG
}

/// Spec §16 — transmission
enum Transmission {
  MANUAL
  AUTOMATIC
  CVT
  DCT
  AMT
  SINGLE_SPEED
}

/// Spec §16 — drivetrain
enum Drivetrain {
  FWD
  RWD
  AWD
  FOUR_WD
}

/// Spec §13, §18, §19 — colour swatches for exterior and interior
enum ColorKind {
  EXTERIOR
  INTERIOR
}

/// Spec §47 (Media), §63 — asset buckets
enum ImageKind {
  MAIN
  GALLERY
  EXTERIOR
  INTERIOR
  WHEEL
  ENGINE
  TRUNK
  /// Anything the fixed groups do not cover — damage, the roof, a detail.
  /// What it is goes in `CarImage.label`.
  OTHER
  /// One frame of a 360° set. Ordered by `sortOrder`; see docs/SPIN_360.md.
  SPIN
}

/// Spec §7 — FR / AR / EN language support
enum Locale {
  EN
  FR
  AR
}

/// Spec §69 — email failures must be logged, never silently swallowed
enum EmailStatus {
  QUEUED
  SENT
  /// Rendered and recorded, but no mail provider is configured, so nothing left
  /// the building. Distinct from SENT on purpose: an administrator reading the
  /// log has to be able to tell a delivered message from one that only reached
  /// the console.
  LOGGED
  FAILED
}

// ============================================================================
// USERS & AUTH — spec §36, §37, §49
// ============================================================================

model User {
  id            String     @id @default(cuid())
  fullName      String     @map("full_name")
  email         String     @unique
  /// Argon2id hash. Null only for accounts created purely via Google OAuth (§3).
  password      String?
  phone         String?
  role          Role       @default(CUSTOMER)
  status        UserStatus @default(ACTIVE)
  profileImage  String?    @map("profile_image")
  googleId      String?    @unique @map("google_id")
  emailVerified Boolean    @default(false) @map("email_verified")
  locale        Locale     @default(EN)
  lastLoginAt   DateTime?  @map("last_login_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  favorites          Favorite[]
  recentlyViewed     RecentlyViewed[]
  comparisons        Comparison[]
  orders             Order[]
  refreshTokens      RefreshToken[]
  passwordResets     PasswordResetToken[]
  carViews           CarView[]
  createdCars        Car[]                @relation("CarCreatedBy")
  orderStatusChanges OrderStatusHistory[] @relation("OrderStatusChangedBy")
  settingUpdates     Setting[]            @relation("SettingUpdatedBy")

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

/// Spec §37 — secure sessions. Rotating refresh tokens, hashed at rest.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Spec §37, §56 — forgot / reset password
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ============================================================================
// BRANDS & CARS — spec §15–§23, §50
// ============================================================================

/// Spec §11 (brand filter), §33 (brand count), §63 (public/images/brands)
model Brand {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  country     String?
  logoUrl     String?  @map("logo_url")
  description String?
  isFeatured  Boolean  @default(false) @map("is_featured")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  cars Car[]

  @@map("brands")
}

/// Vehicle identity (spec §15) plus pricing, status and authored copy.
/// Detailed specification groups live in the 1:1 satellite models below.
model Car {
  id         String   @id @default(cuid())
  slug       String   @unique
  brandId    String   @map("brand_id")
  model      String
  year       Int
  generation String?
  trim       String?
  bodyType   BodyType @map("body_type")
  segment    String?
  category   String?
  doors      Int?
  seats      Int?

  /// Spec §12, §13 — displayed price. Never a floating-point type.
  price      Decimal  @db.Decimal(12, 2)
  /// A promotional price. While set, this is what the customer pays and `price`
  /// is shown struck through beside it. Decimal for the same reason as `price`:
  /// money is never a float.
  promoPrice Decimal? @map("promo_price") @db.Decimal(12, 2)
  currency   String   @default("USD")

  /// A TikTok video for this vehicle, shown on its page. One per car: the
  /// catalogue links to the clip rather than embedding a third-party player,
  /// which would load their scripts on a page we control.
  /// An uploaded clip of this car, served from /uploads. Replaces the TikTok
  /// link the catalogue used to carry: the videos are the seller's own now.
  videoUrl String? @map("video_url")

  /// Spec §23 — concise copy for cards and promo sections
  marketingDescription String? @map("marketing_description")
  /// Spec §14 — universal premium description
  description          String?

  status      CarStatus @default(DRAFT)
  isFeatured  Boolean   @default(false) @map("is_featured")
  /// Spec §73 — seeded development/demo rows must be identifiable, never
  /// presented as real production inventory. Admin UI surfaces this flag.
  isDemoData  Boolean   @default(false) @map("is_demo_data")
  publishedAt DateTime? @map("published_at")
  /// Spec §55 — soft delete: never destroy cars referenced by orders
  deletedAt   DateTime? @map("deleted_at")
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  brand     Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)
  createdBy User? @relation("CarCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  engine       CarEngine?
  wheels       CarWheels?
  exterior     CarExterior?
  interior     CarInterior?
  technology   CarTechnology?
  safety       CarSafety?
  dimensions   CarDimensions?
  colors       CarColor[]
  images       CarImage[]
  translations CarTranslation[]

  favorites      Favorite[]
  recentlyViewed RecentlyViewed[]
  comparisonCars ComparisonCar[]
  orders         Order[]
  views          CarView[]

  @@index([brandId])
  @@index([status, deletedAt])
  @@index([year])
  @@index([price])
  @@index([bodyType])
  @@index([model])
  @@index([createdAt])
  @@map("cars")
}

/// Spec §7 — optional FR/AR overlays for authored car copy. English lives on Car.
model CarTranslation {
  id                   String  @id @default(cuid())
  carId                String  @map("car_id")
  locale               Locale
  marketingDescription String? @map("marketing_description")
  description          String?
  exteriorDescription  String? @map("exterior_description")
  interiorDescription  String? @map("interior_description")

  car Car @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@unique([carId, locale])
  @@map("car_translations")
}

/// Spec §16, §47 — engine & performance
model CarEngine {
  id                      String        @id @default(cuid())
  carId                   String        @unique @map("car_id")
  engineType              String?       @map("engine_type")
  displacementL           Decimal?      @map("displacement_l") @db.Decimal(4, 1)
  displacementCc          Int?          @map("displacement_cc")
  cylinders               Int?
  fuelType                FuelType      @map("fuel_type")
  powerHp                 Int?          @map("power_hp")
  powerKw                 Int?          @map("power_kw")
  powerRpm                String?       @map("power_rpm")
  torqueNm                Int?          @map("torque_nm")
  torqueRpm               String?       @map("torque_rpm")
  transmission            Transmission?
  gears                   Int?
  drivetrain              Drivetrain?
  topSpeedKph             Int?          @map("top_speed_kph")
  acceleration0100        Decimal?      @map("acceleration_0_100") @db.Decimal(4, 1)
  fuelConsumptionCity     Decimal?      @map("fuel_consumption_city") @db.Decimal(4, 1)
  fuelConsumptionHighway  Decimal?      @map("fuel_consumption_highway") @db.Decimal(4, 1)
  fuelConsumptionCombined Decimal?      @map("fuel_consumption_combined") @db.Decimal(4, 1)
  emissionStandard        String?       @map("emission_standard")
  /// Electrified drivetrains (spec §16 fuel types include HYBRID / ELECTRIC)
  batteryCapacityKwh      Decimal?      @map("battery_capacity_kwh") @db.Decimal(6, 1)
  electricRangeKm         Int?          @map("electric_range_km")
  chargingAcKw            Decimal?      @map("charging_ac_kw") @db.Decimal(5, 1)
  chargingDcKw            Decimal?      @map("charging_dc_kw") @db.Decimal(5, 1)

  car Car @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@map("car_engines")
}

/// Spec §17, §47 — wheels & tyres
model CarWheels {
  id            String  @id @default(cuid())
  carId         String  @unique @map("car_id")
  wheelSizeInch Int?    @map("wheel_size_inch")
  wheelType     String? @map("wheel_type")
  wheelDesign   String? @map("wheel_design")
  frontTyreSize String? @map("front_tyre_size")
  rearTyreSize  String? @map("rear_tyre_size")
  tyreType      String? @map("tyre_type")
  spareWheel    String? @map("spare_wheel")
  description   String?

  car Car @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@map("car_wheels")
}

/// Spec §18, §47 — exterior design detail
model CarExterior {
  id                   String  @id @default(cuid())
  carId                String  @unique @map("car_id")
  description          String?
  frontGrille          String? @map("front_grille")
  headlights           String?
  daytimeRunningLights String? @map("daytime_running_lights")
  frontBumper          String? @map("front_bumper")
  hoodDesign           String? @map("hood_design")
  sideProfile          String? @map("side_profile")
  doorDesign           String? @map("door_design")
  sideMirrors          String? @map("side_mirrors")
  wheelArches          String? @map("wheel_arches")
  alloyWheels          String? @map("alloy_wheels")
  rearLights           String? @map("rear_lights")
  rearBumper           String? @map("rear_bumper")
  exhaust              String?
  roofline             String?
  roof                 String?
  spoiler              String?
  bodyLines            String? @map("body_lines")
  aerodynamics         String?

  car Car @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@map("car_exteriors")
}

/// Spec §19, §47 — interior detail
model CarInterior {
  id                 String  @id @default(cuid())
  carId              String  @unique @map("car_id")
  description        String?
  dashboard          String?
  steeringWheel      String? @map("steering_wheel")
  instrumentCluster  String? @map("instrument_cluster")
  infotainmentScreen String? @map("infotainment_screen")
  centerConsole      String? @map("center_console")
  gearSelector       String? @map("gear_selector")
  frontSeats         String? @map("front_seats")
  rearSeats          String? @map("rear_seats")
  seatMaterial       String? @map("seat_material")
  interiorColor      String? @map("interior_color")
  ambientLighting    String? @map("ambient_lighting")
  airConditioning    String? @map("air_conditioning")
  storage            String?
  usbPorts           Int?    @map("usb_ports")
  soundSystem        String? @map("sound_system")
  speakerCount       Int?    @map("speaker_count")
  interiorTechnology String? @map("interior_technology")
  cargoCapacityL     Int?    @map("cargo_capacity_l")

  car Car @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@map("car_interiors")
}

/// Spec §20, §47 — technology (equipment flags)
model CarTechnology {
  id                       String   @id @default(cuid())
  carId                    String   @unique @map("car_id")
  touchscreen              Boolean  @default(false)
  touchscreenSizeInch      Decimal? @map("touchscreen_size_inch") @db.Decimal(4, 1)
  appleCarPlay             Boolean  @default(false) @map("apple_car_play")
  androidAuto              Boolean  @default(false) @map("android_auto")
  bluetooth                Boolean  @default(false)
  navigation               Boolean  @default(false)
  digitalInstrumentCluster Boolean  @default(false) @map("digital_instrument_cluster")
  wirelessCharging         Boolean  @default(false) @map("wireless_charging")
  keylessEntry             Boolean  @default(false) @map("keyless_entry")
  pushButtonStart          Boolean  @default(false) @map("push_button_start")
  parkingSensors           Boolean  @default(false) @map("parking_sensors")
  rearCamera               Boolean  @default(false) @map("rear_camera")
  camera360                Boolean  @default(false) @map("camera_360")
  adaptiveCruiseControl    Boolean  @default(false) @map("adaptive_cruise_control")
  /// Spec §50 — PostgreSQL array where a relation would be overkill
  driveModes               String[] @map("drive_modes")
  notes                    String?

  car Car @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@map("car_technologies")
}

/// Spec §21, §47 — safety & driver assistance
model CarSafety {
  id                         String   @id @default(cuid())
  carId                      String   @unique @map("car_id")
  abs                        Boolean  @default(false)
  electronicStabilityControl Boolean  @default(false) @map("electronic_stability_control")
  tractionControl            Boolean  @default(false) @map("traction_control")
  hillStartAssist            Boolean  @default(false) @map("hill_start_assist")
  autonomousEmergencyBraking Boolean  @default(false) @map("autonomous_emergency_braking")
  forwardCollisionWarning    Boolean  @default(false) @map("forward_collision_warning")
  laneKeepingAssist          Boolean  @default(false) @map("lane_keeping_assist")
  blindSpotMonitoring        Boolean  @default(false) @map("blind_spot_monitoring")
  rearCrossTrafficAlert      Boolean  @default(false) @map("rear_cross_traffic_alert")
  adaptiveCruiseControl      Boolean  @default(false) @map("adaptive_cruise_control")
  parkingAssistance          Boolean  @default(false) @map("parking_assistance")
  airbagCount                Int?     @map("airbag_count")
  airbagTypes                String[] @map("airbag_types")
  ncapRating                 Int?     @map("ncap_rating")
  notes                      String?

  car Car @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@map("car_safeties")
}

/// Spec §22, §47 — dimensions & capacities
model CarDimensions {
  id                String   @id @default(cuid())
  carId             String   @unique @map("car_id")
  lengthMm          Int?     @map("length_mm")
  widthMm           Int?     @map("width_mm")
  heightMm          Int?     @map("height_mm")
  wheelbaseMm       Int?     @map("wheelbase_mm")
  groundClearanceMm Int?     @map("ground_clearance_mm")
  bootCapacityL     Int?     @map("boot_capacity_l")
  bootCapacityMaxL  Int?     @map("boot_capacity_max_l")
  fuelTankL         Decimal? @map("fuel_tank_l") @db.Decimal(5, 1)
  kerbWeightKg      Int?     @map("kerb_weight_kg")

  car Car @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@map("car_dimensions")
}

/// Spec §13 — clickable colour swatches; §18 available exterior colours
model CarColor {
  id         String    @id @default(cuid())
  carId      String    @map("car_id")
  kind       ColorKind @default(EXTERIOR)
  name       String
  hexCode    String    @map("hex_code")
  finish     String?
  imageUrl   String?   @map("image_url")
  priceDelta Decimal?  @map("price_delta") @db.Decimal(12, 2)
  isDefault  Boolean   @default(false) @map("is_default")
  sortOrder  Int       @default(0) @map("sort_order")
  /// How many cars of this colour are on the floor. Never shown to a customer:
  /// they see whether it is available, not how thin the stock is.
  ///
  /// Null means "not counted", which is what every colour that existed before
  /// this column did means — and what the owner leaves it as for a colour they
  /// can always order in. Not counted reads as available; zero reads as sold
  /// out. Those are different statements and the difference matters, which is
  /// why this is nullable rather than defaulting to nought and marking a
  /// catalogue full of cars unavailable the day it was added.
  stock      Int?

  car    Car        @relation(fields: [carId], references: [id], onDelete: Cascade)
  images CarImage[]
  orders Order[]

  @@unique([carId, kind, name])
  @@index([carId])
  @@map("car_colors")
}

/// Spec §47 (Media), §63 — main image, gallery, interior, wheels
model CarImage {
  id        String    @id @default(cuid())
  carId     String    @map("car_id")
  colorId   String?   @map("color_id")
  kind      ImageKind @default(GALLERY)
  url       String
  alt       String?
  /// Heading for an OTHER photograph — "Roof", "Scratch on the rear bumper".
  /// Distinct from `alt`, which describes the picture for a screen reader.
  label     String?
  width     Int?
  height    Int?
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")

  car   Car       @relation(fields: [carId], references: [id], onDelete: Cascade)
  color CarColor? @relation(fields: [colorId], references: [id], onDelete: SetNull)

  @@index([carId, kind])
  @@map("car_images")
}

// ============================================================================
// CUSTOMER FEATURES — spec §51, §52, §53
// ============================================================================

/// Spec §51 — User 1 ─── * Favorites * ─── 1 Car, duplicate-proof
model Favorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  carId     String   @map("car_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  car  Car  @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@unique([userId, carId])
  @@index([userId, createdAt])
  @@index([carId])
  @@map("favorites")
}

/// Spec §52 — most-recent-first, one row per user+car, refreshed on re-view
model RecentlyViewed {
  id       String   @id @default(cuid())
  userId   String   @map("user_id")
  carId    String   @map("car_id")
  viewedAt DateTime @default(now()) @map("viewed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  car  Car  @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@unique([userId, carId])
  @@index([userId, viewedAt])
  @@index([carId])
  @@map("recently_viewed")
}

/// Spec §53 — saved comparisons
model Comparison {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  cars ComparisonCar[]

  @@index([userId, createdAt])
  @@map("comparisons")
}

/// Spec §53 — Comparison ─── * ComparisonCars * ─── Cars, duplicate-proof
model ComparisonCar {
  id           String   @id @default(cuid())
  comparisonId String   @map("comparison_id")
  carId        String   @map("car_id")
  sortOrder    Int      @default(0) @map("sort_order")
  addedAt      DateTime @default(now()) @map("added_at")

  comparison Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  car        Car        @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@unique([comparisonId, carId])
  @@index([carId])
  @@map("comparison_cars")
}

// ============================================================================
// ORDERS — spec §24, §25, §54
// ============================================================================

/// Buyer details are stored on the order on purpose (spec §24): the record must
/// stay historically accurate even if the customer later edits their profile.
model Order {
  id                String      @id @default(cuid())
  reference         String      @unique
  /// Nullable per spec §54 — guest orders remain representable at the DB level
  userId            String?     @map("user_id")
  carId             String      @map("car_id")
  buyerName         String      @map("buyer_name")
  buyerEmail        String      @map("buyer_email")
  buyerPhone        String      @map("buyer_phone")
  selectedColorId   String?     @map("selected_color_id")
  /// Snapshot: survives colour rows being edited or removed later
  selectedColorName String?     @map("selected_color_name")
  message           String?
  status            OrderStatus @default(PENDING)
  adminNote         String?     @map("admin_note")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  user          User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Restrict — spec §55: deleting a car must never destroy order history
  car           Car                  @relation(fields: [carId], references: [id], onDelete: Restrict)
  selectedColor CarColor?            @relation(fields: [selectedColorId], references: [id], onDelete: SetNull)
  statusHistory OrderStatusHistory[]
  emails        EmailLog[]

  @@index([userId, createdAt])
  @@index([carId])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("orders")
}

/// Audit trail for spec §25 status transitions (admin accountability)
model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String       @map("order_id")
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  changedById String?      @map("changed_by_id")
  note        String?
  createdAt   DateTime     @default(now()) @map("created_at")

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation("OrderStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ============================================================================
// ANALYTICS & SETTINGS — spec §33, §45, §68, §69
// ============================================================================

/// Spec §68 — "most viewed cars" needs a real tracking model, not invented data
model CarView {
  id          String   @id @default(cuid())
  carId       String   @map("car_id")
  userId      String?  @map("user_id")
  anonymousId String?  @map("anonymous_id")
  referrer    String?
  viewedAt    DateTime @default(now()) @map("viewed_at")

  car  Car   @relation(fields: [carId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([carId, viewedAt])
  @@index([viewedAt])
  @@index([userId])
  @@map("car_views")
}

/// Spec §33, §75 — website settings, social links, configurable marketing stats
model Setting {
  key         String   @id
  value       Json
  group       String   @default("general")
  /// Public settings are exposed through an unauthenticated read endpoint
  isPublic    Boolean  @default(false) @map("is_public")
  description String?
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation("SettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([group])
  @@map("settings")
}

/// Spec §26, §69 — email delivery must fail safely and be logged
model EmailLog {
  id        String      @id @default(cuid())
  to        String
  subject   String
  template  String
  status    EmailStatus @default(QUEUED)
  error     String?
  orderId   String?     @map("order_id")
  attempts  Int         @default(0)
  sentAt    DateTime?   @map("sent_at")
  createdAt DateTime    @default(now()) @map("created_at")

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([orderId])
  @@map("email_logs")
}
